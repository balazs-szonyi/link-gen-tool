{
  "manifest_version": 3,
  "name": "Link Gen Tool",
  "version": "1.20.2",
  "description": "Generate environment-correct Betsson sportsbook QA links and capture live-login session context (network-level, immune to page fetch/XHR timing races). Companion to the link-gen-tool bookmarklet.",
  "permissions": ["storage", "webRequest", "webNavigation", "debugger", "tabs", "declarativeNetRequest", "declarativeNetRequestFeedback", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["cross-layer-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["bundle-noop.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "Link Gen Tool - click to toggle the panel"
  }
}
